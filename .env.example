LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_SECRET
FRONTEND_ORIGIN=http://localhost:5173
# Set to use direct Gemini models for meeting voice.
GOOGLE_API_KEY=
# Use Gemini Live native audio for lower-latency meeting replies.
MATEO_GEMINI_LIVE=false
# Optional local meeting replies via an installed Ollama model.
MATEO_OLLAMA_MODEL=
# Prefer installed Windows speech synthesis when Gemini meeting voice is configured.
MATEO_USE_WINDOWS_VOICE=false
# Used by the Gemini Skin Check route.
GEMINI_API_KEY=
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_KEY
OPENAI_API_KEY=YOUR_OPENAI_KEY
CARTESIA_API_KEY=YOUR_CARTESIA_KEY
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
SIMLI_API_KEY=YOUR_SIMLI_KEY
SIMLI_FACE_ID=YOUR_SIMLI_FACE_ID
ENABLE_SIMLI=false

# Skin Check uses the connected participant's meeting token automatically.
# Uploads require an active admin session. No development token is needed.
SKIN_PARTICIPANT_LIMIT_10M=3
SKIN_MEETING_LIMIT_1H=20
SKIN_CONCURRENT_LIMIT=1
